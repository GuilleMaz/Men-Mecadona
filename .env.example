# Copia este archivo a `.env` y ajusta lo necesario.
# `.env` no se versiona.

# Entorno: local | development | production
APP_ENV=local

# Sincronizar el catálogo de Mercadona al arrancar si la base está vacía o desactualizada.
SYNC_ON_STARTUP=true

# Tiempo máximo total del solver CP-SAT, en segundos.
OPTIMIZER_TIME_LIMIT_SECONDS=8

# Opcional: directorio de datos. Debe ser una ruta ABSOLUTA y no puede estar
# dentro de OneDrive. Por defecto se usa %LOCALAPPDATA%\Cesta.
# CESTA_DATA_DIR=C:\Users\<usuario>\AppData\Local\Cesta
